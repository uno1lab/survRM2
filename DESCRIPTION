Package: survRM2
Type: Package
Title: Comparing Restricted Mean Survival Time
Version: 1.0-5
Date: 2026-11-21
Authors@R: c(person(given = "Hajime", family = "Uno", role = c("aut", "cre"),
                    email = "huno@jimmy.harvard.edu"),
             person(given = "Lu", family = "Tian", role = "aut"),
